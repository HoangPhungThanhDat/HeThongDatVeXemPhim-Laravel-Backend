# ═══════════════════════════════════════════════════════════
# 🚨 BỔ SUNG — QUAN TRỌNG CHO DỰ ÁN
# ═══════════════════════════════════════════════════════════

# Environment — tất cả các biến thể
.env.local
.env.staging
.env.testing
.env.*.local

# Database SQLite (chứa user, order, token...)
/database/database.sqlite
/database/*.sqlite
/database/*.sqlite3

# Scribe — auto-generated docs cache
/.scribe/endpoints.cache/
/.scribe/.filehashes

# Storage — không commit ảnh/video upload lên Git
/storage/app/public/uploads/
/storage/app/private/uploads/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/
/storage/logs/
!/storage/logs/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore

# Build output
/public/vendor/
/public/build/
/public/hot

# ═══════════════════════════════════════════════════════════
# IDE / EDITOR
# ═══════════════════════════════════════════════════════════
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/

