# ═══════════════════════════════════════════════════════════
# TỰ ĐỘNG PHÁT HIỆN TEXT/BINARY
# ═══════════════════════════════════════════════════════════
* text=auto

# ═══════════════════════════════════════════════════════════
# LINE ENDINGS — Tránh conflict giữa Windows / Mac / Linux
# ═══════════════════════════════════════════════════════════
*.php      text eol=lf
*.blade.php text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.html     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.xml      text eol=lf
*.env      text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Windows scripts phải dùng CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ═══════════════════════════════════════════════════════════
# FILE BINARY — Không convert gì cả
# ═══════════════════════════════════════════════════════════
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.svg      text
*.pdf      binary
*.zip      binary
*.tar      binary
*.gz       binary
*.7z       binary
*.ttf      binary
*.woff     binary
*.woff2    binary
*.eot      binary
*.otf      binary
*.mp3      binary
*.mp4      binary
*.wav      binary
*.webm     binary

# Database / SQLite
*.sqlite   binary
*.sqlite3  binary
*.db       binary

# ═══════════════════════════════════════════════════════════
# DIFF HIỂN THỊ ĐẸP HƠN
# ═══════════════════════════════════════════════════════════
*.blade.php diff=html
*.html      diff=html
*.css       diff=css
*.scss      diff=css
*.md        diff=markdown
*.php       diff=php

# Lock files — không hiển thị trong diff stats
composer.lock -diff
package-lock.json -diff
yarn.lock -diff
pnpm-lock.yaml -diff

# ═══════════════════════════════════════════════════════════
# EXPORT IGNORE — Bỏ khi `git archive`
# ═══════════════════════════════════════════════════════════
/.github           export-ignore
/tests             export-ignore
/phpunit.xml       export-ignore
/.editorconfig     export-ignore
/.gitattributes    export-ignore
/.gitignore        export-ignore
/CHANGELOG.md      export-ignore
/README.md         export-ignore
/.scribe           export-ignore